+*/
+
+package mock
+
+import (
+	"context"
+	"testing"
+
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/client-go/kubernetes/fake"
+	k8stesting "k8s.io/client-go/testing"
+)
+
+const testNode = "node-1"
+
+func bindingTestPod(name string) *corev1.Pod {
+	return &corev1.Pod{
+		ObjectMeta: metav1.ObjectMeta{
+			Namespace: "default", Name: name, UID: types.UID("uid-" + name),
+			Annotations: map[string]string{
+				assignedNodeAnnotation: testNode,
+				bindTimeAnnotation:     "1792065600",
+				bindPhaseAnnotation:    bindPhaseAllocating,
+			},
+		},
+		Spec:   corev1.PodSpec{NodeName: testNode},
+		Status: corev1.PodStatus{Phase: corev1.PodPending},
+	}
+}
+
+func testNodeWithLock(lock string) *corev1.Node {
+	n := &corev1.Node{ObjectMeta: metav1.ObjectMeta{Name: testNode, ResourceVersion: "1"}}
+	if lock != "" {
+		n.Annotations = map[string]string{nodeLockAnnotation: lock}
+	}
+	return n
+}
+
+func assertBindPhase(t *testing.T, c *fake.Clientset, name, want string) {
+	t.Helper()
+	p, err := c.CoreV1().Pods("default").Get(context.Background(), name, metav1.GetOptions{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := p.Annotations[bindPhaseAnnotation]; got != want {
+		t.Errorf("pod %s: bind phase %q, want %q", name, got, want)
+	}
+}
+
+func assertNoLock(t *testing.T, c *fake.Clientset) {
+	t.Helper()
+	n, err := c.CoreV1().Nodes().Get(context.Background(), testNode, metav1.GetOptions{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if v, ok := n.Annotations[nodeLockAnnotation]; ok {
+		t.Errorf("node lock %q not released", v)
+	}
+}
+
+func countPatches(c *fake.Clientset) int {
+	n := 0
+	for _, a := range c.Actions() {
+		if _, ok := a.(k8stesting.PatchAction); ok {
+			n++
+		}
+	}
+	return n
+}
+
+func TestCompleteBindLockedPod(t *testing.T) {
+	ctx := context.Background()
+	c := fake.NewSimpleClientset(
+		testNodeWithLock("2026-10-15T10:00:00Z,default,locked"),
+		bindingTestPod("locked"),
+		bindingTestPod("next"),
+	)
+	if err := completeBind(ctx, c, testNode); err != nil {
+		t.Fatal(err)
+	}
+	assertBindPhase(t, c, "locked", bindPhaseSuccess)
+	assertBindPhase(t, c, "next", bindPhaseAllocating)
+	assertNoLock(t, c)
+}
+
+func TestCompleteBindIsIdempotent(t *testing.T) {
+	ctx := context.Background()
+	c := fake.NewSimpleClientset(testNodeWithLock("2026-10-15T10:00:00Z,default,only"), bindingTestPod("only"))
+	if err := completeBind(ctx, c, testNode); err != nil {
+		t.Fatal(err)
+	}
+	c.ClearActions()
+	if err := completeBind(ctx, c, testNode); err != nil {
+		t.Fatal(err)
+	}
+	if n := countPatches(c); n != 0 {
+		t.Errorf("second call patched %d objects", n)
+	}
+	assertBindPhase(t, c, "only", bindPhaseSuccess)
+	assertNoLock(t, c)
+}
+
+func TestCompleteBindWithoutLockFallsBackToPendingPod(t *testing.T) {
+	running := bindingTestPod("running")
+	running.Status.Phase = corev1.PodRunning
+	c := fake.NewSimpleClientset(testNodeWithLock(""), running, bindingTestPod("pending"))
+	if err := completeBind(context.Background(), c, testNode); err != nil {
+		t.Fatal(err)
+	}
+	assertBindPhase(t, c, "pending", bindPhaseSuccess)
+	assertBindPhase(t, c, "running", bindPhaseAllocating)
+}
+
+func TestCompleteBindOnlyForTheLockOwner(t *testing.T) {
+	// A lock names a pod that is gone: like HAMi's device plugin, do not fall
+	// back to another pod while the lock is held.
+	const lock = "2026-10-15T10:00:00Z,default,gone"
+	c := fake.NewSimpleClientset(testNodeWithLock(lock), bindingTestPod("pending"))
+	if err := completeBind(context.Background(), c, testNode); err == nil {
+		t.Error("want an error for a lock naming a missing pod")
+	}
+	if n := countPatches(c); n != 0 {
+		t.Errorf("patched %d objects", n)
+	}
+	assertBindPhase(t, c, "pending", bindPhaseAllocating)
+}
