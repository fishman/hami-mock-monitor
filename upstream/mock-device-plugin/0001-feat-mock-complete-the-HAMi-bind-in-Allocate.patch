+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package mock
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/client-go/kubernetes"
+	"k8s.io/klog/v2"
+)
+
+// HAMi scheduler conventions (HAMi pkg/util/types.go, pkg/util/nodelock).
+const (
+	assignedNodeAnnotation = "hami.io/vgpu-node"
+	bindTimeAnnotation     = "hami.io/bind-time"
+	bindPhaseAnnotation    = "hami.io/bind-phase"
+	bindPhaseAllocating    = "allocating"
+	bindPhaseSuccess       = "success"
+	nodeLockAnnotation     = "hami.io/mutex.lock"
+)
+
+// completeBind does what HAMi's device plugins do at the end of Allocate: mark
+// the pod HAMi is binding on this node hami.io/bind-phase=success and release
+// the node lock HAMi's scheduler took in Bind. Without it the pod stays
+// "allocating" and the next pod on the node waits for the lock to expire.
+//
+// kubelet calls Allocate once per mocked resource a container requests, so
+// this must be idempotent: once the pod is marked and the lock is released,
+// later calls find nothing to do.
+func completeBind(ctx context.Context, c kubernetes.Interface, nodeName string) error {
+	if nodeName == "" {
+		return errors.New("NODE_NAME is not set")
+	}
+	node, err := c.CoreV1().Nodes().Get(ctx, nodeName, metav1.GetOptions{})
+	if err != nil {
+		return err
+	}
+	pod, err := bindingPod(ctx, c, node)
+	if err != nil || pod == nil {
+		return err
+	}
+	if pod.Annotations[bindPhaseAnnotation] != bindPhaseSuccess {
+		// The uid makes the patch fail rather than land on a pod that
+		// reused the name.
+		patch, err := json.Marshal(map[string]any{"metadata": map[string]any{
+			"uid":         pod.UID,
+			"annotations": map[string]string{bindPhaseAnnotation: bindPhaseSuccess},
+		}})
+		if err != nil {
+			return err
+		}
+		if _, err := c.CoreV1().Pods(pod.Namespace).Patch(ctx, pod.Name, types.MergePatchType, patch, metav1.PatchOptions{}); err != nil {
+			return fmt.Errorf("patch pod %s/%s: %w", pod.Namespace, pod.Name, err)
+		}
+		klog.Infof("HAMi bind of pod %s/%s completed", pod.Namespace, pod.Name)
+	}
+	return releaseNodeLock(ctx, c, node, pod)
+}
+
+// bindingPod mirrors HAMi's util.GetPendingPod: the pod the node lock names,
+// else, without a lock owner, a Pending pod HAMi is binding to this node.
+func bindingPod(ctx context.Context, c kubernetes.Interface, node *corev1.Node) (*corev1.Pod, error) {
+	// The lock is "RFC3339,namespace,name"; the legacy form is a bare timestamp.
+	if lock := node.Annotations[nodeLockAnnotation]; strings.Contains(lock, ",") {
+		f := strings.Split(lock, ",")
+		if len(f) != 3 || f[1] == "" || f[2] == "" {
+			return nil, fmt.Errorf("malformed node lock %q", lock)
+		}
+		return c.CoreV1().Pods(f[1]).Get(ctx, f[2], metav1.GetOptions{})
+	}
+	pods, err := c.CoreV1().Pods("").List(ctx, metav1.ListOptions{FieldSelector: "spec.nodeName=" + node.Name})
+	if err != nil {
+		return nil, err
+	}
+	for i := range pods.Items {
+		p := &pods.Items[i]
+		if _, ok := p.Annotations[bindTimeAnnotation]; ok && p.Status.Phase == corev1.PodPending &&
+			p.Annotations[bindPhaseAnnotation] == bindPhaseAllocating &&
+			p.Annotations[assignedNodeAnnotation] == node.Name {
+			return p, nil
+		}
+	}
+	return nil, nil
+}
+
+// releaseNodeLock removes the node lock, which bindingPod ensured is either
+// held by pod or in the legacy owner-less form, as HAMi's
+// nodelock.ReleaseNodeLock does.
+func releaseNodeLock(ctx context.Context, c kubernetes.Interface, node *corev1.Node, pod *corev1.Pod) error {
+	if _, ok := node.Annotations[nodeLockAnnotation]; !ok {
+		return nil
+	}
+	// The resourceVersion makes the release conditional on the lock read above.
+	patch, err := json.Marshal(map[string]any{"metadata": map[string]any{
+		"resourceVersion": node.ResourceVersion,
+		"annotations":     map[string]any{nodeLockAnnotation: nil},
+	}})
+	if err != nil {
+		return err
+	}
+	if _, err := c.CoreV1().Nodes().Patch(ctx, node.Name, types.MergePatchType, patch, metav1.PatchOptions{}); err != nil {
+		return fmt.Errorf("release node lock of %s: %w", node.Name, err)
+	}
+	klog.Infof("HAMi node lock of %s released for pod %s/%s", node.Name, pod.Namespace, pod.Name)
+	return nil
+}
