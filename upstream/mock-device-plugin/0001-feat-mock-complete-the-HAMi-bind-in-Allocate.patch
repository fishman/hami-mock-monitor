 import (
 	"context"
 	"fmt"
+	"os"
 	"sync/atomic"
 	"time"
 
 	"k8s.io/klog/v2"
 	kubeletdevicepluginv1beta1 "k8s.io/kubelet/pkg/apis/deviceplugin/v1beta1"
+
+	"github.com/HAMi/mock-device-plugin/internal/pkg/util/client"
 )
 
 // Plugin is identical to DevicePluginServer interface of device plugin API.
@@ -107,6 +110,12 @@ func (p *MockPlugin) Allocate(ctx context.Context, reqs *kubeletdevicepluginv1be
 		response.ContainerResponses = append(response.ContainerResponses, &car)
 	}
 
+	// HAMi's scheduler waits for the device plugin to report the bind. A failed
+	// report must not fail the allocation; HAMi's node lock expires on its own.
+	if err := completeBind(ctx, client.GetClient(), os.Getenv("NODE_NAME")); err != nil {
+		klog.Warningf("complete HAMi bind: %v", err)
+	}
+
 	return &response, nil
 }
 
